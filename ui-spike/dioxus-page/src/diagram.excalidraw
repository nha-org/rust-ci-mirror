    {"id": "a1", "type": "arrow", "x": 190, "y": 230, "width": 90, "height": 0, "strokeColor": "#1e1e1e", "points": [[0, 0], [90, 0]], "startBinding": {"elementId": "views"}, "endBinding": {"elementId": "tree"}},
    {"id": "a2", "type": "arrow", "x": 470, "y": 230, "width": 120, "height": 120, "strokeColor": "#1e1e1e", "points": [[0, 0], [120, -120]], "startBinding": {"elementId": "tree"}, "endBinding": {"elementId": "web"}},
    {"id": "a3", "type": "arrow", "x": 470, "y": 230, "width": 120, "height": 120, "strokeColor": "#1e1e1e", "points": [[0, 0], [120, 120]], "startBinding": {"elementId": "tree"}, "endBinding": {"elementId": "window"}},
    {"id": "a4", "type": "arrow", "x": 375, "y": 400, "width": 0, "height": 105, "strokeColor": "#1e1e1e", "points": [[0, 0], [0, -105]], "startBinding": {"elementId": "agents"}, "endBinding": {"elementId": "tree"}},
    {"id": "t1", "type": "text", "containerId": "views", "text": "Views", "x": 0, "y": 0, "width": 0, "height": 0, "fontSize": 18, "strokeColor": "#1e1e1e"},
    {"id": "t2", "type": "text", "containerId": "tree", "text": "UI tree", "x": 0, "y": 0, "width": 0, "height": 0, "fontSize": 18, "strokeColor": "#1e1e1e"},
