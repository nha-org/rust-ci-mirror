// slintcn's semantic layer, remapped to design.json: its own comment says « to remap a semantic role, change the picks ».
// Palette is gone: every value is Ds, generated by build.rs.
import { Ds, Theme, ThemeMode } from "ds.slint";
export { Ds, Theme, ThemeMode }

export global Tokens {
    out property <color> color-background: Ds.color-base-100;
    out property <color> color-foreground: Ds.color-base-content;
    out property <color> color-card: Ds.color-base-100;
    out property <color> color-primary: Ds.color-primary;
    out property <color> color-primary-foreground: Ds.color-primary-content;
    out property <color> color-secondary: Ds.color-base-300;
    out property <color> color-muted: Ds.color-base-300;
    out property <color> color-muted-foreground: Ds.muted;
    out property <color> color-destructive: Ds.color-error;
    out property <color> color-accent: Ds.color-base-200;
    out property <color> color-ring: Ds.color-primary;
    out property <color> color-ring-muted: Ds.tint;
    out property <length> focus-ring-width: 3px;
    out property <length> focus-ring-offset: 3px;
    out property <color> color-surface-1: Ds.color-base-100;
    out property <color> color-surface-2: Ds.color-base-300;
    out property <color> color-surface-3: Ds.color-base-300;
    out property <color> color-border-hairline: Ds.hair;
    out property <color> color-border-hairline-strong: Ds.hair;
    out property <length> radius-sm: Ds.radius-selector;
    out property <length> radius-md: Ds.radius-field;
    out property <length> radius-lg: Ds.radius-box;
    out property <length> radius-xl: Ds.radius-box;
    out property <duration> motion-fast: 120ms;
    out property <duration> motion-base: 200ms;
    out property <easing> motion-easing-standard: ease-out;
    out property <int> typography-weight-medium: 500;
    out property <int> typography-weight-semibold: 600;
    out property <length> typography-body-sm-size: Ds.text-caption;
    out property <length> typography-body-size: Ds.text-ui;
    out property <length> typography-label-size: Ds.text-caption;
    out property <length> typography-title-size: Ds.text-title;
    out property <length> spacing-sm: Ds.spacing-s2;
    out property <length> spacing-md: Ds.spacing-s3;
    out property <length> density-button-default: 32px;
    out property <length> density-input: 32px;
}
