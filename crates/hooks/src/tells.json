{
  "why": "(@nha, 2026-10-22, on rfc-dashboard: « \"stays with him\" em-dashes \"load-bearing\" \"it's not X it's Y\" and other AI-isms are banned everywhere. search for them online and make sure we ban them all »). Read by dash_hooks::outbound (every message to a person, embedded at build: its tests compile each row) and, through the link private/dashboard/priv/ai_isms.json, by Dashboard.AiIsms (mix lint on private/docs, dash task style) until task rust-lint-port. (@nha, 2026-11-12, on « Mon X, c'est Y : »: « Same as \"It is not X it is Y\". », « better yet port this to rust. ») Case-insensitive; text inside « » or “ ” is a quote, never flagged.",
  "sources": [
    "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing",
    "https://tropes.fyi/directory",
    "https://www.pangram.com/signs-of-ai-writing"
  ],
  "rows": [
    {"regex": "—", "label": "an em-dash", "instead": "a period, a comma, a colon or parentheses"},
    {"regex": "\\bload-bearing\\b", "label": "« load-bearing »", "instead": "say what depends on it"},
    {"regex": "\\b(stays|remains) with (him|her|them|you|nicolas)\\b", "label": "« stays with him »", "instead": "say who does what: « he writes it », « he decides »"},
    {"regex": "\\b(it['’]s|it is|this is|that['’]s|they['’]re) not\\b[^.;:!?«»“”]{1,60},\\s*(it['’]s|it is|this is|that['’]s|they['’]re)\\b", "label": "« it's not X, it's Y »", "instead": "state Y alone"},
    {"regex": "\\bnot (just|only|merely)\\b[^.;:!?«»“”]{1,60}\\bbut\\b", "label": "« not just X but Y »", "instead": "state both plainly, or Y alone"},
    {"regex": "\\bno [^,.;:]{1,30}, no [^,.;:]{1,30}, just\\b", "label": "« no X, no Y, just Z »", "instead": "state Z"},
    {"regex": "\\bdelv(e|es|ed|ing)\\b", "label": "« delve »", "instead": "look at, read, dig into"},
    {"regex": "\\btapestry\\b", "label": "« tapestry »", "instead": "say what it is"},
    {"regex": "\\b(a|is a|stands as a|serves as a) testament\\b", "label": "« a testament to »", "instead": "say what it shows"},
    {"regex": "\\b(serves|stands) as (a|an|the)\\b", "label": "« serves as »", "instead": "« is »"},
    {"regex": "\\bpivotal\\b", "label": "« pivotal »", "instead": "say why it matters"},
    {"regex": "\\bintricac(y|ies)\\b|\\bintricate\\b", "label": "« intricate »", "instead": "say what makes it hard"},
    {"regex": "\\bmeticulous(ly)?\\b", "label": "« meticulous »", "instead": "say what was checked"},
    {"regex": "\\bvibrant\\b", "label": "« vibrant »", "instead": "drop it"},
    {"regex": "\\bshowcas(e|es|ed|ing)\\b", "label": "« showcase »", "instead": "show"},
    {"regex": "\\bunderscor(e|es|ed|ing)\\b", "label": "« underscore »", "instead": "show, say"},
    {"regex": "\\bgarner(s|ed|ing)?\\b", "label": "« garner »", "instead": "get"},
    {"regex": "\\bmultifaceted\\b", "label": "« multifaceted »", "instead": "name the parts"},
    {"regex": "\\bseamless(ly)?\\b", "label": "« seamless »", "instead": "say what the user does not have to do"},
    {"regex": "\\bgame[- ]changer\\b|\\bgroundbreaking\\b|\\bunprecedented\\b", "label": "hype (« game-changer », « groundbreaking »)", "instead": "the number or the fact"},
    {"regex": "\\bboasts\\b|\\bnestled\\b|\\bin the heart of\\b|\\bdiverse array\\b|\\brich (cultural )?heritage\\b", "label": "brochure words (« boasts », « nestled »)", "instead": "the plain fact"},
    {"regex": "\\b(evolving|ever-changing|digital|competitive) landscape\\b", "label": "« the landscape »", "instead": "name the market, the field or the tools"},
    {"regex": "\\bfoster(s|ed|ing)?\\b", "label": "« foster »", "instead": "help, build"},
    {"regex": "\\bholistic(ally)?\\b", "label": "« holistic »", "instead": "say what it covers"},
    {"regex": "\\bleverag(e|es|ed|ing)\\b", "label": "« leverage »", "instead": "use"},
    {"regex": "\\b(it['’]s|it is) worth noting\\b|\\bworth noting that\\b", "label": "« it's worth noting »", "instead": "state it"},
    {"regex": "\\blet['’]s (dive|delve|break (this|it) down)\\b|\\bdeep dive\\b|\\bdive into\\b", "label": "« let's dive in »", "instead": "start with the point"},
    {"regex": "\\bhere['’]s the (thing|kicker|catch)\\b|\\bthe kicker\\b", "label": "« here's the thing »", "instead": "state it"},
    {"regex": "\\bthink of it (as|like)\\b|\\bimagine a world\\b", "label": "« think of it as »", "instead": "say what it is"},
    {"regex": "\\bin conclusion\\b|\\bat its core\\b|\\bin essence\\b", "label": "a signposted wrap-up (« in conclusion », « at its core »)", "instead": "drop it"},
    {"regex": "\\bquietly\\b", "label": "« quietly », a magic adverb", "instead": "say what happened"},
    {"regex": "\\b(valuable|actionable) insights?\\b", "label": "« valuable insights »", "instead": "the finding itself"},
    {"regex": "\\bdespite (these|its|the) challenges\\b", "label": "« despite these challenges »", "instead": "name the problem and what was done"},
    {"regex": "\\bi hope this helps\\b|\\bgreat question\\b|\\bcertainly!|\\bas an ai\\b", "label": "chatbot filler (« I hope this helps »)", "instead": "drop it"},
    {"regex": "\\b(mon|ma|mes|notre|nos) [^,.;:!?«»“”]{1,40}, c['’]est\\b[^.;!?«»“”]{0,60}:(\\s|$)", "label": "« Mon X, c'est Y : », a colon reveal", "instead": "state Y: « Je travaille sur la plateforme. »"},
    {"regex": "\\b(ce n['’]est|c['’]est|ça n['’]est) pas\\b[^.;:!?«»“”]{1,60},\\s*c['’]est\\b", "label": "« ce n'est pas X, c'est Y »", "instead": "state Y alone"},
    {"regex": "\\bil ne s['’]agit pas\\b", "label": "« il ne s'agit pas de X »", "instead": "say what it is"},
    {"regex": "\\b(is|are) (my|our) ground\\s*([.,;:!?)]|$)|\\b(my|our) ground is\\b", "label": "« X is my ground »", "instead": "« I work on X »"}
  ]
}
